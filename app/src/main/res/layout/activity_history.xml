<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="16dp"
    android:paddingEnd="24dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageButton
            android:id="@+id/backBtn"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/nav_bg"
            android:contentDescription="Terug"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/nav_text" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:text="Geschiedenis"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button android:id="@+id/fAll" style="@style/Tab" android:text="Alles" />
        <Button android:id="@+id/fResume" style="@style/Tab" android:text="Verder kijken" />
        <Button android:id="@+id/fVod" style="@style/Tab" android:text="Films &amp; series" />
        <Button android:id="@+id/fLive" style="@style/Tab" android:text="Live tv" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button android:id="@+id/clearBtn" style="@style/Tab" android:layout_marginEnd="0dp" android:drawableStart="@drawable/ic_delete" android:drawablePadding="8dp" android:drawableTint="@color/nav_text" android:text="Geschiedenis wissen" />
    </LinearLayout>

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:text="Houd OK ingedrukt om iets uit je geschiedenis te verwijderen"
        android:textColor="@color/muted"
        android:textSize="12sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/panel_bg">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="4dp" />

        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Nog niets bekeken."
            android:textColor="@color/muted"
            android:textSize="15sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
