<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        app:keep_content_on_player_reset="false"
        app:resize_mode="fit"
        app:shutter_background_color="#000000"
        app:use_controller="false" />

    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/panel_bg"
        android:gravity="center"
        android:lineSpacingExtra="6dp"
        android:padding="24dp"
        android:textColor="@color/text"
        android:textSize="18sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/info_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="32dp"
        android:paddingTop="60dp"
        android:paddingEnd="32dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/infoNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/accent"
            android:textSize="34sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/infoLogo"
            android:layout_width="96dp"
            android:layout_height="56dp"
            android:layout_marginStart="24dp"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/infoName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/infoNow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text"
                android:textSize="18sp" />

            <ProgressBar
                android:id="@+id/infoProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:max="1000"
                android:progressBackgroundTint="#55FFFFFF"
                android:progressTint="@color/accent" />

            <TextView
                android:id="@+id/infoNext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/muted"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/infoHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/star"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/infoGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/muted"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Pauzescherm (zoals bij streamingdiensten) -->
    <FrameLayout
        android:id="@+id/pauseOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/pause_bg"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="520dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="48dp"
            android:layout_marginTop="56dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/pauseLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Je kijkt naar"
                android:textColor="#B3FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/pauseTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#FFFFFF"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pauseSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/pauseDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:ellipsize="end"
                android:lineSpacingExtra="3dp"
                android:maxLines="5"
                android:textColor="#D9FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="48dp"
            android:paddingEnd="48dp"
            android:paddingBottom="36dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:drawableStart="@drawable/ic_pause"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:text="Gepauzeerd"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pausePos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <ProgressBar
                    android:id="@+id/pauseProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:layout_weight="1"
                    android:max="1000"
                    android:progressBackgroundTint="#55FFFFFF"
                    android:progressTint="#E50914" />

                <TextView
                    android:id="@+id/pauseLeft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <Button android:id="@+id/pauseBack" style="@style/PauseButton" android:drawableStart="@drawable/ic_rewind" android:drawablePadding="8dp" android:drawableTint="@color/round_btn_text" android:text="10 sec" />
                <Button android:id="@+id/pausePlay" style="@style/PauseButton" android:drawableStart="@drawable/ic_play" android:drawablePadding="8dp" android:drawableTint="@color/round_btn_text" android:text="Verder kijken" />
                <Button android:id="@+id/pauseFwd" style="@style/PauseButton" android:drawableStart="@drawable/ic_forward" android:drawablePadding="8dp" android:drawableTint="@color/round_btn_text" android:text="10 sec" />
                <Button android:id="@+id/pauseRestart" style="@style/PauseButton" android:drawableStart="@drawable/ic_replay" android:drawablePadding="8dp" android:drawableTint="@color/round_btn_text" android:text="Vanaf begin" />
                <Button android:id="@+id/pauseNext" style="@style/PauseButton" android:drawableStart="@drawable/ic_skip_next" android:drawablePadding="8dp" android:drawableTint="@color/round_btn_text" android:text="Volgende aflevering" android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
