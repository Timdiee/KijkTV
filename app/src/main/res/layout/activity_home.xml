<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Achtergrondbeeld van het uitgelichte item -->
    <ImageView
        android:id="@+id/heroImage"
        android:layout_width="560dp"
        android:layout_height="260dp"
        android:layout_gravity="top|end"
        android:alpha="0.55"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:background="@drawable/hero_fade" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="14dp">

        <!-- Menubalk -->
        <LinearLayout
            android:id="@+id/nav"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="32dp"
            android:paddingEnd="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="18dp"
                android:text="KijkTV"
                android:textColor="@color/text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Button android:id="@+id/navHome" style="@style/NavTab" android:text="Home" />
            <Button android:id="@+id/navLive" style="@style/NavTab" android:text="Live tv" />
            <Button android:id="@+id/navGuide" style="@style/NavTab" android:text="Tv-gids" />
            <Button android:id="@+id/navMovies" style="@style/NavTab" android:text="Films" />
            <Button android:id="@+id/navSeries" style="@style/NavTab" android:text="Series" />
            <Button android:id="@+id/navHistory" style="@style/NavTab" android:text="Geschiedenis" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:textColor="@color/text"
                android:textSize="17sp" />

            <ImageButton
                android:id="@+id/navSettings"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/nav_bg"
                android:contentDescription="Instellingen"
                android:src="@drawable/ic_settings"
                android:tint="@color/nav_text" />
        </LinearLayout>

        <!-- Uitgelicht -->
        <LinearLayout
            android:layout_width="460dp"
            android:layout_height="170dp"
            android:layout_marginStart="32dp"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/heroLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="true"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/heroTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/text"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/heroMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#D9FFFFFF"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/heroProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="220dp"
                android:layout_height="4dp"
                android:layout_marginTop="8dp"
                android:max="1000"
                android:progressBackgroundTint="#40FFFFFF"
                android:progressTint="@color/accent"
                android:visibility="gone" />

            <TextView
                android:id="@+id/heroDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                android:maxLines="3"
                android:textColor="#B3FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Rijen -->
        <ScrollView
            android:id="@+id/rowsScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="24dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <TextView
        android:id="@+id/homeMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="120dp"
        android:textColor="@color/muted"
        android:textSize="15sp" />
</FrameLayout>
